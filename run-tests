#!/bin/sh
# Every check, in one command. The docs check is included deliberately: a
# feature that is not documented is not finished.
fail=0
for t in tests/test_*.py; do
    printf '%-28s ' "$(basename "$t")"
    if out=$(python3 "$t" 2>&1); then
        echo "$out" | tail -1
    else
        echo "FAILED"; echo "$out" | sed 's/^/    /'; fail=1
    fi
done
[ "$fail" -eq 0 ] && echo "\nall checks pass" || echo "\nSOME CHECKS FAILED"
exit $fail
